    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "readable-stream": "^4.5.2",
    "rxjs": "^7.8.1",
    "stream-http": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@sentry/cli": "^2.39.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
