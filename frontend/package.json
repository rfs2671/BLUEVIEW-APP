{
  "name": "levelog",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx serve dist -l 3000 -s",
    "dev": "expo start --web --port 3000",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 3000",
    "build": "node scripts/build-with-sourcemaps.js",
    "build:expo-only": "expo export --platform web --clear",
    "update": "eas update --auto",
    "smoke": "node scripts/smoke-mount.cjs --dist dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
